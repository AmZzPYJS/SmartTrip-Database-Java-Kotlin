<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.smarttrip">

    <!-- Permissions existantes -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ── NOUVELLES permissions pour le GPS en arrière-plan ─────────────── -->
    <!-- Obligatoire Android 9+ pour les ForegroundService -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Obligatoire Android 14+ pour les services de localisation -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- GPS en arrière-plan (écran éteint, app minimisée) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Empêche le téléphone de mettre le CPU en veille pendant la collecte -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Envoyer des notifications (obligatoire Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ──────────────────────────────────────────────────────────────────── -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="SmartTrip"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartTrip"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity" />
        <activity android:name=".TripsActivity" />
        <activity android:name=".TripDetailsActivity" />
        <activity android:name=".ActiveTripActivity" />
        <activity android:name=".SettingsActivity" />

        <!-- ── ForegroundService GPS ──────────────────────────────────────── -->
        <!-- foregroundServiceType="location" obligatoire Android 10+ -->
        <service
            android:name=".GpsTrackingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />
        <!-- ──────────────────────────────────────────────────────────────── -->

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.smarttrip.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>