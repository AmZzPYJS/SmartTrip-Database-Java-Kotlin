<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp" android:background="#F8FAFC">
    <!--  Statut en haut  -->
    <TextView android:id="@+id/tvTripStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="● Voyage en cours" android:textSize="20sp" android:textStyle="bold" android:textColor="#059669" android:layout_marginBottom="24dp"/>
    <!--  Compteurs  -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="#EEF2FF" android:padding="16dp" android:layout_marginEnd="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Points GPS" android:textSize="12sp" android:textColor="#6366F1"/>
            <TextView android:id="@+id/tvGpsCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 points GPS" android:textSize="18sp" android:textStyle="bold" android:textColor="#312E81"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="#ECFDF5" android:padding="16dp" android:layout_marginStart="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Points d'intérêt" android:textSize="12sp" android:textColor="#059669"/>
            <TextView android:id="@+id/tvPoiCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 POI" android:textSize="18sp" android:textStyle="bold" android:textColor="#064E3B"/>
        </LinearLayout>
    </LinearLayout>
    <!--  Batterie live  -->
    <TextView android:id="@+id/tvBatteryLive" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Batterie : chargement..." android:textSize="13sp" android:textColor="#6B7280" android:background="#F1F5F9" android:padding="12dp" android:layout_marginBottom="24dp"/>
    <!--  Espace flexible  -->
    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
    <!--  Boutons d'action  -->
    <Button android:id="@+id/btnAddPoi" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📍 Ajouter un point d'intérêt" android:minHeight="48dp" android:layout_marginBottom="12dp"/>
    <Button android:id="@+id/btnStopTrip" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⏹ Terminer le voyage" android:minHeight="48dp" android:backgroundTint="#DC2626"/>
</LinearLayout>