<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp" android:background="#F8FAFC">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Paramètres" android:textSize="28sp" android:textStyle="bold" android:textColor="#111827" android:layout_marginBottom="24dp"/>
    <!--  Section Batterie  -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gestion de la batterie" android:textSize="18sp" android:textStyle="bold" android:textColor="#374151" android:layout_marginBottom="12dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#FFFFFF" android:orientation="vertical" android:padding="16dp" android:elevation="1dp" android:layout_marginBottom="16dp">
        <TextView android:id="@+id/tvBatteryInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#374151" android:lineSpacingExtra="6dp"/>
    </LinearLayout>
    <!--  Section Collecte GPS  -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Collecte de données" android:textSize="18sp" android:textStyle="bold" android:textColor="#374151" android:layout_marginBottom="12dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#FFFFFF" android:orientation="vertical" android:padding="16dp" android:elevation="1dp" android:layout_marginBottom="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Collecte GPS active" android:textSize="15sp" android:textColor="#374151"/>
            <Switch android:id="@+id/switchGps" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView android:id="@+id/tvThreshold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#9CA3AF" android:layout_marginTop="8dp"/>
    </LinearLayout>
    <!--  Info technique  -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Backend : MongoDB Atlas + FastAPI\nStockage : Cloud NoSQL\nVersion : 1.0-demo" android:textSize="12sp" android:textColor="#9CA3AF" android:lineSpacingExtra="4dp" android:layout_marginTop="24dp" android:gravity="center"/>
</LinearLayout>